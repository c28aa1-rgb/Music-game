# Copy this file to .env and fill in your own values.

# From https://developer.spotify.com/dashboard -> your app -> Settings -> Client ID.
# This is safe to expose in the browser; the PKCE flow never uses a client secret.
SPOTIFY_CLIENT_ID=

# Port the server listens on. Render sets this for you in production.
PORT=3000

# Cards a player needs to win.
TARGET_CARDS=10

# How long the reveal stays on screen before the game moves itself on.
REVEAL_MS=5000

# "Alex is up, starting in 3" — breathing room between turns.
INTRO_MS=3000

# Dead time at the start of each song where nobody may steal.
STEAL_LOCK_MS=10000

# How long a stealer gets to pick both answers. Running out counts as wrong.
STEAL_ANSWER_MS=6000

# How long the steal result holds the room before play resumes.
VERDICT_MS=2800

# Extra songs required beyond the player count before a game may start.
# Wrong guesses recycle back into the deck now, so this is about variety,
# not "won't the game just end abruptly" — safe to lower for a small set.
MIN_DECK_BUFFER=8

# Point the server at a different song pool. Used by the test suites so they
# can never touch the resolved one.
# SONGS_FILE=songs.test.json
